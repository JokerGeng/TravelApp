@page "/"


@using Newtonsoft.Json
@using System.IdentityModel.Tokens.Jwt

@inject NavigationManager Navigation

<h3>AppLaunch</h3>

Loading...

@code {
	protected async override Task OnInitializedAsync()
	{
		try
		{
			var userDetailStr = await SecureStorage.GetAsync(nameof(Setting.UserDetail));

			if (!string.IsNullOrWhiteSpace(userDetailStr))
			{
				var userDetal = JsonConvert.DeserializeObject<UserDetail>(userDetailStr);

				var handler = new JwtSecurityTokenHandler();
				var jsonToken = handler.ReadToken(userDetal.Token) as JwtSecurityToken;

				if (jsonToken.ValidTo < DateTime.Now)
				{
					Navigation.NavigateTo("/login");

				}
				else
				{
					Setting.UserDetail = userDetal;
					Navigation.NavigateTo("/mainView");
				}
			}
			else
			{
				Navigation.NavigateTo("/login");
			}
		}
		catch (Exception ex)
		{
			Navigation.NavigateTo("/login");
		}

	}
}
